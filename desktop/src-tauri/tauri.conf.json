{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windmill",
  "version": "0.4.0",
  "identifier": "app.windmill.desktop",
  "build": {
    "frontendDist": "../../docs/app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Windmill",
        "decorations": false,
        "maximized": false,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "minWidth": 900,
        "minHeight": 600,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/wallpapers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Windmill",
    "shortDescription": "Your computer's apps, in one calm space.",
    "longDescription": "Windmill is a calm, full-screen space for the apps already on your computer: a dock, a search, a panel on Ctrl+Win, wallpapers and more.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "bannerPath": "icons/installer/wix-banner.bmp",
        "dialogImagePath": "icons/installer/wix-dialog.bmp"
      }
    }
  }
}
