{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Windmill page may use.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-fullscreen",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "opener:default"
  ]
}
